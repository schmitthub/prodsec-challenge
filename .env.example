# PROJECT ENV

# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost

# Environment: local, staging, production
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ENVIRONMENT=local

PROJECT_NAME="Records API"
STACK_NAME=records_api

# Backend
BACKEND_CORS_ORIGINS="http://localhost:3000, http://localhost:8080, http://localhost:8000"
SECRET_KEY=""
# Password for the local fixture accounts seeded by app/initial_data.py
SEED_PASSWORD=""

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend

# Lab vendor
LAB_VENDOR_API_KEY=""
DEBUG_VENDOR_URL="https://vendor-api.example.test"
# Hosts the staff vendor-preview webhook may fetch (comma-separated, https only)
WEBHOOK_ALLOWED_HOSTS=vendor-api.example.test
