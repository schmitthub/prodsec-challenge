{
  "format": "sec-review-eval/v1",
  "id": "routing-dry-run",
  "tags": ["routing", "paths", "cost"],
  "limits": {"runs": 1, "max_turns": 15, "timeout_seconds": 600},
  "prompt": "prompt.md",
  "setup": {"path": "setup.sh"},
  "checks": [
    {"id": "routing", "kind": "rubric", "path": "graders/routing.md"},
    {
      "id": "plan-printed",
      "kind": "output_regex",
      "pattern": "sec-review plan:",
      "ignore_case": true
    },
    {"id": "no-agents", "kind": "agent_count", "max": 0}
  ]
}
