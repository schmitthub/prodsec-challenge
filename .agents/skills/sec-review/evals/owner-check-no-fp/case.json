{
  "format": "sec-review-eval/v1",
  "id": "owner-check-no-fp",
  "tags": ["access-control", "false-positive"],
  "limits": {"runs": 1, "max_turns": 40, "timeout_seconds": 1200},
  "prompt": "prompt.md",
  "setup": {"path": "setup.sh"},
  "checks": [
    {"id": "judge", "kind": "rubric", "path": "graders/judge.md"},
    {
      "id": "no-surviving-finding",
      "kind": "output_regex",
      "pattern": "sec-review: none — pass"
    },
    {"id": "subagent-budget", "kind": "agent_count", "min": 2, "max": 5},
    {
      "id": "reviewer-roles",
      "kind": "agent_roles",
      "required": ["general", "access-control"],
      "forbidden": ["verifier"]
    }
  ]
}
