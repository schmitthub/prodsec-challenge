{
  "format": "sec-review-eval/v1",
  "id": "v1-delete-idor",
  "tags": ["access-control", "variant", "block"],
  "limits": {"runs": 1, "max_turns": 40, "timeout_seconds": 1200},
  "prompt": "prompt.md",
  "setup": {"path": "setup.sh"},
  "checks": [
    {"id": "judge", "kind": "rubric", "path": "graders/judge.md"},
    {
      "id": "decision-blocks",
      "kind": "output_regex",
      "pattern": "sec-review: (critical|high) — (block|escalate)"
    },
    {
      "id": "finding-class",
      "kind": "output_regex",
      "pattern": "\"class\":\\s*\"access-control\"|class.*access-control",
      "ignore_case": true
    },
    {"id": "subagent-budget", "kind": "agent_count", "min": 2, "max": 5},
    {
      "id": "reviewer-roles",
      "kind": "agent_roles",
      "required": ["general", "access-control"],
      "forbidden": ["verifier"]
    }
  ]
}
